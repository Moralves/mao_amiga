{
  "name": "mao-amiga-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Repositório Mão Amiga - Frontend (Expo / React Native) e Backend (Spring Boot)",
  "scripts": {
    "install:front": "npm --prefix frontend install",
    "start": "npm --prefix frontend start",
    "front": "npm --prefix frontend start",
    "front:android": "npm --prefix frontend run android",
    "front:ios": "npm --prefix frontend run ios",
    "front:web": "npm --prefix frontend run web",
    "front:typecheck": "npm --prefix frontend run typecheck",
    "api": "node -e \"const {spawn}=require('child_process');const p=spawn(process.platform==='win32'?'mvnw.cmd':'./mvnw',['spring-boot:run'],{cwd:'api',stdio:'inherit',shell:true});p.on('exit',c=>process.exit(c??0))\"",
    "back": "node -e \"const {spawn}=require('child_process');const p=spawn(process.platform==='win32'?'mvnw.cmd':'./mvnw',['spring-boot:run'],{cwd:'api',stdio:'inherit',shell:true});p.on('exit',c=>process.exit(c??0))\"",
    "back:test": "node -e \"const {spawn}=require('child_process');const p=spawn(process.platform==='win32'?'mvnw.cmd':'./mvnw',['test'],{cwd:'api',stdio:'inherit',shell:true});p.on('exit',c=>process.exit(c??0))\""
  }
}
